> pkgname <- "ksTable"
> source(file.path(R.home("share"), "R", "examples-header.R"))
> options(warn = 1)
> library('ksTable')
> 
> base::assign(".oldSearch", base::search(), pos = 'CheckExEnv')
> base::assign(".old_wd", base::getwd(), pos = 'CheckExEnv')
> cleanEx()
> nameEx("kst_compile")
> ### * kst_compile
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: kst_compile
> ### Title: Compile a JSON DSL table spec to a plain R script
> ### Aliases: kst_compile
> 
> ### ** Examples
> 
> spec <- '{
+   "schema_version": "1.0",
+   "table_spec": {
+     "parameter": { "age": { "variable": "AGE", "label": "Age (years)" } },
+     "statistics": { "n": { "fun": "count", "label": "n" } },
+     "groups": { "by": ["TRT"] },
+     "layout": { "row_structure": "parameter_stat", "column_structure": "groups" }
+   }
+ }'
> cat(kst_compile(spec))
.chunks <- list()

.chunks[[1L]] <- data |>
  dplyr::group_by(TRT) |>
  dplyr::summarize(
    .value_raw  = count(AGE),
    .groups     = "drop"
  ) |>
  dplyr::mutate(
    .value      = as.character(.value_raw),
    .param      = "Age (years)",
    .stat_label = "n",
    .value_raw  = NULL
  )

.long <- dplyr::bind_rows(.chunks)

tidyr::pivot_wider(
  .long,
  id_cols     = c(.param, .stat_label),
  names_from  = c(TRT),
  values_from = .value
)> 
> 
> 
> 
> cleanEx()
